// Phase 0 確認用のデザインシステムトークン（SPEC §7.1 / §7.2「やさしい」配色）
export global Theme {
    // 配色（やさしい）
    out property <color> bg: #F3F1EC;
    out property <color> surface: #FBFAF7;
    out property <color> text: #2E2E2B;
    out property <color> text-muted: #5E5D58;
    out property <color> border: #D9D5CC;
    out property <color> border-control: #7D7A72;
    out property <color> accent: #2F6F6A;
    out property <color> on-accent: #FFFFFF;
    out property <color> focus: #2B5FA6;
    out property <color> select: #DCE9E6;
    out property <color> danger: #A63A3A;
    out property <color> on-danger: #FFFFFF;

    // 文字サイズ（基準 16 / 18 / 22 / 26px を切替）
    in-out property <length> font-base: 16px;
    out property <length> font-heading: root.font-base * 1.5;
    out property <length> font-small: max(14px, root.font-base * 0.875);
    // BIZ UDPゴシックの natural line height は 1.0000em のため 1.6 で厳密に 1.6em になる
    out property <float> line-height: 1.6;

    // 余白・角丸・枠線幅・最小サイズ（余白は SPEC §7.1 に従い固定論理 px）
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;
    out property <length> radius: 8px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> focus-width: 3px;
    out property <length> indicator-height: 3px;
    out property <length> touch-min: 44px;
    out property <length> tab-min-width: 120px;
    out property <length> action-min-width: 140px;
    out property <length> row-min-height: 28px;
    out property <length> sample-label-width: root.font-base * 3.5;
    out property <length> multi-input-min-height: 130px;
    out property <length> log-box-min-height: 96px;
    out property <length> time-range-width: root.font-base * 8.75;
}
