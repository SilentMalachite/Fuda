// Phase 0 確認用メインウィンドウ（タブ切替で Phase 0-2 と Phase 0-3 を切り替え）
import "../fonts/BIZUDPGothic-Regular.ttf";
import "../fonts/BIZUDPGothic-Bold.ttf";
import { SpikePalette } from "palette.slint";
import { Phase02FontView } from "phase02_font.slint";
import { Phase03ImeView } from "phase03_ime.slint";

// タブ切り替えボタン（最小高さ 44px、3px フォーカス枠、色だけに頼らない選択表示）
component TabButton inherits FocusScope {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    min-height: 44px;
    min-width: 180px;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.clicked();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        background: root.selected ? SpikePalette.select : SpikePalette.surface;
        border-width: root.has-focus ? 3px : 1px;
        border-color: root.has-focus ? SpikePalette.focus : SpikePalette.border;

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 8px;

            Text {
                text: root.label;
                font-size: 16px;
                font-weight: root.selected ? 700 : 400;
                color: SpikePalette.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // 選択中の下線（太さ 3px、色だけに頼らない表示）
        if root.selected: Rectangle {
            x: 8px;
            y: parent.height - 4px;
            width: parent.width - 16px;
            height: 3px;
            background: SpikePalette.accent;
        }

        TouchArea {
            clicked => {
                root.focus();
                root.clicked();
            }
        }
    }
}

export component SpikeWindow inherits Window {
    title: @tr("fuda 技術確認 (Phase 0-3: 日本語入力と IME)");
    min-width: 960px;
    min-height: 640px;
    preferred-width: 960px;
    preferred-height: 760px;
    background: SpikePalette.bg;
    default-font-family: "BIZ UDPGothic";
    default-font-size: 16px;

    // 0: Phase 0-2 フォント確認、1: Phase 0-3 日本語入力確認（初期表示）
    in-out property <int> active-tab: 1;

    // Phase 0-3 用の公開プロパティ・コールバック（Rust 側との橋渡し）
    in-out property <string> line-text: "";
    in-out property <string> multi-text: "";
    in property <int> accepted-count: 0;
    in property <int> line-edited-count: 0;
    in property <int> multi-line-count: 1;
    in property <int> multi-char-count: 0;
    in property <string> added-cards-text: "";
    in property <string> event-log-text: "";

    callback line-accepted(string);
    callback line-edited(string);
    callback line-key-pressed(string, bool);
    callback multi-edited(string);
    callback multi-key-pressed(string, bool);
    callback clear-all();

    VerticalLayout {
        width: 100%;
        height: 100%;

        // 上部タブバー
        Rectangle {
            background: SpikePalette.surface;
            border-width: 1px;
            border-color: SpikePalette.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 12px;
                alignment: start;

                TabButton {
                    label: @tr("0-2 フォント");
                    selected: root.active-tab == 0;
                    clicked => {
                        root.active-tab = 0;
                    }
                }

                TabButton {
                    label: @tr("0-3 日本語入力");
                    selected: root.active-tab == 1;
                    clicked => {
                        root.active-tab = 1;
                    }
                }
            }
        }

        // タブに応じた確認ビュー
        if root.active-tab == 0: Phase02FontView {
            vertical-stretch: 1;
        }

        if root.active-tab == 1: Phase03ImeView {
            vertical-stretch: 1;
            line-text <=> root.line-text;
            multi-text <=> root.multi-text;
            accepted-count: root.accepted-count;
            line-edited-count: root.line-edited-count;
            multi-line-count: root.multi-line-count;
            multi-char-count: root.multi-char-count;
            added-cards-text: root.added-cards-text;
            event-log-text: root.event-log-text;
            line-accepted(text) => {
                root.line-accepted(text);
            }
            line-edited(text) => {
                root.line-edited(text);
            }
            line-key-pressed(key, has-mod) => {
                root.line-key-pressed(key, has-mod);
            }
            multi-edited(text) => {
                root.multi-edited(text);
            }
            multi-key-pressed(key, has-mod) => {
                root.multi-key-pressed(key, has-mod);
            }
            clear-all => {
                root.clear-all();
            }
        }
    }
}
