// Phase 0 確認用の配色トークン（SPEC §7.2「やさしい」配色）
export global SpikePalette {
    out property <color> bg: #F3F1EC;
    out property <color> surface: #FBFAF7;
    out property <color> text: #2E2E2B;
    out property <color> text-muted: #5E5D58;
    out property <color> border: #D9D5CC;
    out property <color> accent: #2F6F6A;
    out property <color> on-accent: #FFFFFF;
    out property <color> focus: #2B5FA6;
    out property <color> select: #DCE9E6;
}
